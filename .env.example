# LLM provider: "mock" (default, no key needed), "gemini", or "openai"
LLM_PROVIDER=mock

# Only required when LLM_PROVIDER=gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Only required when LLM_PROVIDER=openai.
# Any OpenAI-compatible endpoint works (OpenAI, Azure, LiteLLM, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

API_PORT=3001

# Abort an LLM call that has not returned, in milliseconds.
LLM_TIMEOUT_MS=20000
